{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2023", "DOM"],
		"types": ["node"],
		"rootDir": "src",
		"outDir": "dist/io.github.cdcxd.herdr.sdPlugin",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"rewriteRelativeImportExtensions": true,
		"skipLibCheck": true
	},
	"include": ["src"]
}
